    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "convert_are_to_json.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/convert_are_to_json.py",
            "args": ["-i", "D:/github/mudmapper/area",
                    "-o", "D:/github/mudmapper/area"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "convert_json_to_mudlet_xml.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/convert_json_to_mudlet_xml.py",
            "args": ["-i", "D:/github/mudmapper/area",
                    "-o", "map.xml"
            ],
            "console": "integratedTerminal"
        }
    ]
}